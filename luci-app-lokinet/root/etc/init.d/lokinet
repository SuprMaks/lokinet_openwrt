#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/lokinet
CONFIG_FILE=/var/lib/lokinet/lokinet.ini
GENERATOR=/usr/libexec/lokinet/generate-config

start_service() {
	[ -x "$PROG" ] || {
		logger -t lokinet "Executable $PROG not found"
		return 1
	}

	[ -x "$GENERATOR" ] || {
		logger -t lokinet "Configuration generator not found"
		return 1
	}

	mkdir -p /var/lib/lokinet || return 1
	"$GENERATOR" || {
		logger -t lokinet "Failed to generate $CONFIG_FILE"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG" --config "$CONFIG_FILE"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger lokinet
}

reload_service() {
	"$GENERATOR" || return 1
	# Lokinet configuration is not assumed to be hot-reloadable.
	# procd will restart the instance on reload.
	stop
	start
}

stop_service() {
	:
}
